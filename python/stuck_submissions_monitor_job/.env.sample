# Stuck Submissions Monitor Job - Environment Variables

# General
LOG_LEVEL=DEBUG
ENVIRONMENT=dev

# Postgres
DB_HOST=db
DB_USER=testuser
DB_PASS=pass
DB_PORT=5432
DB_NAME_FF_API=formsflow_api

# Keycloak
KEYCLOAK_AUTH_URL=http://keycloak:8080/auth/
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=test-client
KEYCLOAK_CLIENT_SECRET=secret

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=
MONGO_DB_NAME=formio

# Splunk
SPLUNK_HOST=localhost
SPLUNK_PORT=8088
SPLUNK_TOKEN=your-splunk-token
OPENSHIFT_PLATE=stuck_submissions_monitor_job

# Retry submission
RETRY_SUBMISSION_URL=http://localhost:5009/
FORMIO_BASE_URL=http://localhost:3001
WEB_FORM_BASE_URL=http://localhost:3009/digitalforms
