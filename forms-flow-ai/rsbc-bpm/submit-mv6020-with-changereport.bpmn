    <bpmn:scriptTask id="find_parent_submission" name="Find Parent Submission" scriptFormat="groovy">
      <bpmn:incoming>Flow_1l4woa3</bpmn:incoming>
      <bpmn:outgoing>Flow_cr_find_to_gateway</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper

// Change report: build the Form.io URL of the parent revision. New reports leave it null.
def data = new JsonSlurper().parseText(S(execution.getVariable("formData")).toString())
def url = null
def ids = '^[0-9a-f]{24}$'  // Form.io ObjectIds only
if (String.valueOf(data.isChangeReport) == "true") {
    def formId = String.valueOf(data.parentFormId)
    def submissionId = String.valueOf(data.parentSubmissionId)
    if (formId ==~ ids) {
        if (submissionId ==~ ids) {
            def formUrl = String.valueOf(execution.getVariable("formUrl"))
            def base = formUrl.substring(0, formUrl.indexOf("/form/"))
            url = base + "/form/" + formId + "/submission/" + submissionId
        }
    }
}
execution.setVariable("parentSubmissionUrl", url)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="gateway_change_report" name="Change report?" default="Flow_cr_new_report">
      <bpmn:incoming>Flow_cr_find_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_cr_change_report</bpmn:outgoing>
      <bpmn:outgoing>Flow_cr_new_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="read_parent_submission" name="Read Parent Submission" camunda:asyncBefore="true" camunda:expression="${formSubmissionService.readSubmission(parentSubmissionUrl)}" camunda:resultVariable="parentSubmission">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT5M</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cr_change_report</bpmn:incoming>
      <bpmn:outgoing>Flow_cr_parent_to_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_cr_find_to_gateway" sourceRef="find_parent_submission" targetRef="gateway_change_report"/>
    <bpmn:sequenceFlow id="Flow_cr_change_report" name="Yes" sourceRef="gateway_change_report" targetRef="read_parent_submission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${parentSubmissionUrl != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="gateway_change_report_join">
      <bpmn:incoming>Flow_cr_new_report</bpmn:incoming>
      <bpmn:incoming>Flow_cr_parent_to_join</bpmn:incoming>
      <bpmn:outgoing>Flow_cr_join_to_payload</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_cr_new_report" name="No" sourceRef="gateway_change_report" targetRef="gateway_change_report_join"/>
    <bpmn:sequenceFlow id="Flow_cr_parent_to_join" sourceRef="read_parent_submission" targetRef="gateway_change_report_join"/>
